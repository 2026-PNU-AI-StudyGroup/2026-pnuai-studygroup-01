NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=3000
ENABLE_DEVELOPMENT_MOCK_AUTH=false
DEVELOPMENT_MOCK_AUTH_HOSTS=
APP_URL=https://projects.example.pusan.ac.kr
BETTER_AUTH_URL=https://projects.example.pusan.ac.kr
BETTER_AUTH_SECRET=replace_with_a_random_value_from_openssl_rand_base64_48
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_ADMIN_EMAIL=
CRON_SECRET=replace_with_a_separate_random_value_from_openssl_rand_base64_48

POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=replace_with_a_random_database_password
DATABASE_URL=postgresql://pms:replace_with_a_random_database_password@postgres:5432/pms?schema=public

MINIO_ROOT_USER=pms
MINIO_ROOT_PASSWORD=replace_with_a_random_object_storage_password
MINIO_BUCKET=pms-production
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pms
S3_SECRET_KEY=replace_with_a_random_object_storage_password
S3_FORCE_PATH_STYLE=true

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:2b
