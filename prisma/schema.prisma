generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
  ADVISOR
}

enum UserAccountStatus {
  ACTIVE
  DISABLED
  WITHDRAWN
}

enum TopicStatus {
  PENDING_APPROVAL
  REJECTED
  ACTIVE
}

enum TopicApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TopicApplicationMode {
  TEAM_ONLY
  INDIVIDUAL_ONLY
  INDIVIDUAL_OR_TEAM
}

enum TopicApplicationKind {
  INDIVIDUAL
  TEAM
}

enum TopicApplicationParticipantRole {
  LEADER
  MEMBER
}

enum ProjectTeamMembershipRole {
  LEADER
  MEMBER
}

enum ProjectTeamMembershipEndReason {
  LEFT
  REMOVED
  ACCOUNT_WITHDRAWN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum StoredFileStatus {
  PENDING
  READY
  ATTACHED
}

enum FilePurpose {
  REPORT
  ARTIFACT
  ANNOUNCEMENT
}

enum UploadConsumer {
  REPORT
  ARTIFACT
  ANNOUNCEMENT
}

enum RubricAudience {
  STAFF_ONLY
  TEAM_MEMBERS
}

enum ApprovalDecisionType {
  APPROVED
  REVISION_REQUESTED
}

enum ArtifactType {
  PRESENTATION_VIDEO
  SOURCE_CODE
  POSTER
  OTHER
  IMAGE
}

enum RecruitmentPostStatus {
  OPEN
  CLOSED
}

enum RecruitmentApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum StudentTeamMemberRole {
  LEADER
  MEMBER
}

enum ProjectTeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum StudentTeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum TopicApprovalRoute {
  PROFESSOR
  ADMIN
}

enum TopicApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELED
}

enum AuditActorKind {
  USER
  SYSTEM
}

enum ProjectAssistantInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum ProjectGuidanceRequestKind {
  MEETING
  REVIEW
}

enum ProjectGuidanceRequestStatus {
  PENDING
  ANSWERED
  CANCELED
}

enum AuditAction {
  PROFESSOR_ACCESS_GRANTED
  PROFESSOR_ACCESS_REVOKED
  USER_DEACTIVATED
  USER_REACTIVATED
  ADMIN_ROLE_GRANTED
  ADMIN_ROLE_REVOKED
  TEAM_CONFIRMED
  TEAM_CLOSED
  USER_WITHDRAWN
  PROJECT_TEAM_CONFIRMED
  PROJECT_COMPLETED
  PROJECT_CANCELED
  PROJECT_RESTORED
  PROJECT_REVIEW_REQUESTED
  PROJECT_TEAM_MEMBER_LEFT
  PROJECT_TEAM_MEMBER_REMOVED
  PROJECT_TEAM_LEADERSHIP_TRANSFERRED
  PROJECT_TEAM_MEMBERSHIP_CORRECTED
  PROGRAM_CLOSED
  REPORT_REQUIREMENT_SET
  REPORT_REQUIREMENT_REMOVED
  REPORT_APPROVED
  REPORT_REVISION_REQUESTED
  PROJECT_ASSISTANT_INVITED
  PROJECT_ASSISTANT_ACCEPTED
  PROJECT_ASSISTANT_REMOVED
  TOPIC_CLOSED
  TOPIC_RECRUITMENT_CLOSED
  TOPIC_APPROVAL_APPROVED
  TOPIC_APPROVAL_REJECTED
  TOPIC_DELETED
  PROGRAM_DIVISION_CREATED
  PROGRAM_DIVISION_UPDATED
  PROGRAM_DIVISION_DELETED
  PROGRAM_VOTING_RESET
  PROGRAM_REPORT_DEFINITION_CREATED
  PROGRAM_REPORT_DEFINITION_UPDATED
  PROGRAM_REPORT_DEFINITION_ARCHIVED
  PROGRAM_REPORT_DEFINITION_DELETED
  PROGRAM_RUBRIC_CREATED
  PROGRAM_RUBRIC_UPDATED
  PROGRAM_RUBRIC_ARCHIVED
  PROGRAM_DIVISION_RUBRIC_MODE_CHANGED
  ADVISOR_REGISTERED
  ADVISOR_TOKEN_ISSUED
  ADVISOR_TOKEN_REVOKED
  ADVISOR_TEAMS_ASSIGNED
}

enum NotificationType {
  APPLICATION_RESULT
  REPORT_ACTIVITY
  PROJECT_REQUEST
  DISCUSSION
  TOPIC_APPROVAL
  DEADLINE
  SYSTEM
}

enum EmailDeliveryKind {
  TEAM_INVITATION
  PROJECT_ASSISTANT_INVITATION
  RECRUITMENT_APPLICATION
  RECRUITMENT_RESULT
  TOPIC_APPLICATION
  APPLICATION_RESULT
  TOPIC_APPROVAL
  PROJECT_REQUEST
  TASK_ASSIGNMENT
  PROJECT_MEMBERSHIP
  DEADLINE
  ACCOUNT_STATUS
  PROFESSOR_ACCESS
  REPORT_ACTIVITY
  DISCUSSION
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  SENT
  FAILED
  CANCELED
}

enum EmailDeliveryRecipientType {
  REGISTERED
  DIRECT
}

enum TranslationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FeedbackTargetScreen {
  STUDENT
  PROFESSOR
  ADMIN
  COMMON
}

enum FeedbackType {
  FEATURE
  BUG
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

model User {
  id                                 String                              @id
  name                               String
  email                              String                              @unique
  emailVerified                      Boolean                             @default(false)
  image                              String?
  role                               UserRole                            @default(STUDENT)
  accountStatus                      UserAccountStatus                   @default(ACTIVE)
  withdrawnAt                        DateTime?
  preferredLocale                    String                              @default("ko")
  department                         String?
  studentNumber                      String?                             @unique
  grade                              Int?
  phoneNumber                        String?
  contactEmail                       String?
  onboardingRequired                 Boolean                             @default(false)
  onboardingCompletedAt              DateTime?
  privacyConsentAt                 DateTime?
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  sessions                           Session[]
  accounts                           Account[]
  allowlistEntriesCreated            ProfessorAllowlist[]                @relation("AllowlistCreator")
  topics                             Topic[]                             @relation("TopicAuthor")
  topicsManaged                      Topic[]                             @relation("TopicManager")
  projectAssistantMemberships        ProjectAssistant[]                  @relation("ProjectAssistantUser")
  projectAssistantMembershipsGranted ProjectAssistant[]                  @relation("ProjectAssistantGrantor")
  projectAssistantInvitations        ProjectAssistantInvitation[]        @relation("ProjectAssistantInvitee")
  projectAssistantInvitationsSent    ProjectAssistantInvitation[]        @relation("ProjectAssistantInviter")
  projectGuidanceRequests            ProjectGuidanceRequest[]            @relation("ProjectGuidanceRequester")
  projectGuidanceResponses           ProjectGuidanceRequest[]            @relation("ProjectGuidanceResponder")
  topicApplications                  TopicApplication[]
  topicApplicationsDecided           TopicApplication[]                  @relation("TopicApplicationDecider")
  projectTeamMemberships             ProjectTeamMembership[]
  tasksCreated                       Task[]                              @relation("TaskCreator")
  taskAssignments                    TaskAssignee[]
  progressUpdates                    ProgressUpdate[]
  discussionPosts                    DiscussionPost[]
  storedFiles                        StoredFile[]
  reportVersionsSubmitted            ReportVersion[]
  approvalDecisions                  ApprovalDecision[]
  reportFeedback                     ReportFeedback[]                    @relation("ReportFeedbackAuthor")
  feedbackPostsResolved              FeedbackPost[]                      @relation("FeedbackPostResolver")
  feedbackStatusChanges              FeedbackStatusChange[]              @relation("FeedbackStatusChangeActor")
  feedbackComments                   FeedbackComment[]                   @relation("FeedbackCommentAuthor")
  artifactsRegistered                Artifact[]
  recruitmentPosts                   RecruitmentPost[]
  recruitmentApplications            RecruitmentApplication[]
  projectProgramsCreated             ProjectProgram[]
  auditLogsCreated                   AuditLog[]                          @relation("AuditLogActor")
  notifications                      Notification[]
  emailPreference                    EmailPreference?
  emailDeliveries                    EmailDelivery[]
  studentProfile                     StudentProfile?
  topicApplicationGroupsLed          TopicApplicationGroup[]             @relation("TopicApplicationGroupLeader")
  studentTeamsLed                    StudentTeam[]                       @relation("StudentTeamLeader")
  studentTeamMemberships             StudentTeamMember[]
  projectTeamInvitations             ProjectTeamInvitation[]             @relation("ProjectTeamInvitee")
  projectTeamInvitationsSent         ProjectTeamInvitation[]             @relation("ProjectTeamInviter")
  studentTeamInvitations             StudentTeamInvitation[]             @relation("StudentTeamInvitee")
  studentTeamInvitationsSent         StudentTeamInvitation[]             @relation("StudentTeamInviter")
  topicApprovalsRequested            TopicApprovalRequest[]              @relation("TopicApprovalRequester")
  topicApprovalsAssigned             TopicApprovalRequest[]              @relation("TopicApprovalProfessor")
  topicApprovalsDecided              TopicApprovalRequest[]              @relation("TopicApprovalDecider")
  studentTeamRecruitments            StudentTeamRecruitmentPost[]        @relation("StudentTeamRecruitmentAuthor")
  studentTeamRecruitmentApplications StudentTeamRecruitmentApplication[] @relation("StudentTeamRecruitmentApplicant")
  announcements                      Announcement[]
  announcementAttachmentsUploaded    AnnouncementAttachment[]            @relation("AnnouncementAttachmentUploader")
  profileImage                       UserProfileImage?
  profileImageUploads                ProfileImageUpload[]                @relation("ProfileImageUploadOwner")
  projectVotes                       ProjectVote[]
  advisorAccessTokens                AdvisorAccessToken[]
  projectAdvisors                    ProjectAdvisor[]                    @relation("ProjectAdvisorUser")
  grantedProjectAdvisors             ProjectAdvisor[]                    @relation("ProjectAdvisorGrantor")
  advisorEvaluations                 AdvisorEvaluation[]
  advisorFeedbacks                   AdvisorFeedback[]
  managedPrograms                    ProgramManager[]

  @@map("user")
}

enum AnnouncementVisibility {
  AUTHENTICATED
  TARGET_MEMBERS
}

model Announcement {
  id            String                   @id @default(uuid())
  authorId      String
  title         String
  content       String
  visibility    AnnouncementVisibility   @default(AUTHENTICATED)
  pinned        Boolean                  @default(false)
  // 로그인 후 화면에 창으로 띄울 공지. 전체 공지에만 붙는다.
  popup         Boolean                  @default(false)
  projectTeamId String?
  programId     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  author        User                     @relation(fields: [authorId], references: [id])
  projectTeam   ProjectTeam?             @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  program       ProjectProgram?          @relation(fields: [programId], references: [id], onDelete: Cascade)
  attachments   AnnouncementAttachment[]

  @@index([createdAt])
  @@index([authorId])
  @@index([pinned, createdAt])
  @@index([popup, createdAt])
  @@index([projectTeamId, createdAt])
  @@index([programId, createdAt])
  @@map("announcement")
}

model AnnouncementAttachment {
  fileId         String       @id
  announcementId String
  uploadedById   String
  position       Int
  createdAt      DateTime     @default(now())
  file           StoredFile   @relation(fields: [fileId], references: [id], onDelete: NoAction)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("AnnouncementAttachmentUploader", fields: [uploadedById], references: [id])

  @@unique([announcementId, position])
  @@index([uploadedById])
  @@map("announcement_attachment")
}

model TranslationSource {
  hash         String              @id
  text         String
  createdAt    DateTime            @default(now())
  translations StoredTranslation[]
  jobs         TranslationJob[]

  @@map("translation_source")
}

model StoredTranslation {
  id           String            @id @default(uuid())
  sourceHash   String
  targetLocale String
  text         String
  model        String
  translatedAt DateTime          @default(now())
  source       TranslationSource @relation(fields: [sourceHash], references: [hash], onDelete: Cascade)

  @@unique([sourceHash, targetLocale])
  @@index([targetLocale, sourceHash])
  @@map("stored_translation")
}

model TranslationJob {
  id           String               @id @default(uuid())
  sourceHash   String
  targetLocale String
  status       TranslationJobStatus @default(PENDING)
  attempts     Int                  @default(0)
  availableAt  DateTime             @default(now())
  lockedAt     DateTime?
  lastError    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  source       TranslationSource    @relation(fields: [sourceHash], references: [hash], onDelete: Cascade)

  @@unique([sourceHash, targetLocale])
  @@index([status, availableAt, createdAt])
  @@map("translation_job")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  type        NotificationType
  title       String
  body        String
  href        String
  dedupeKey   String           @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notification")
}

// 프로그램마다 담당 관리자를 둔다. 프로그램 운영 알림은 여기 지정된 사람에게만 간다.
// 지정이 없는 프로그램은 예전처럼 관리자 전체에게 간다.
model ProgramManager {
  programId String
  userId    String
  createdAt DateTime       @default(now())
  program   ProjectProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([programId, userId])
  @@index([userId])
  @@map("program_manager")
}

model EmailPreference {
  userId                 String   @id
  reportActivityEnabled  Boolean  @default(false)
  discussionEnabled      Boolean  @default(false)
  programActivityEnabled Boolean  @default(false)
  deadlineEnabled        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_preference")
}

model EmailDelivery {
  id                     String                     @id @default(uuid())
  kind                   EmailDeliveryKind
  recipientUserId        String?
  recipientType          EmailDeliveryRecipientType @default(REGISTERED)
  recipientEmail         String
  locale                 String                     @default("ko")
  title                  String?
  body                   String?
  titleEn                String?
  bodyEn                 String?
  href                   String?
  priority               Int                        @default(100)
  optional               Boolean                    @default(false)
  allowInactiveRecipient Boolean                    @default(false)
  idempotencyKey         String                     @unique
  status                 EmailDeliveryStatus        @default(PENDING)
  attempts               Int                        @default(0)
  availableAt            DateTime                   @default(now())
  lockedAt               DateTime?
  lockedBy               String?
  sentAt                 DateTime?
  providerMessageId      String?
  lastError              String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  recipient              User?                      @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, availableAt, priority, createdAt])
  @@index([sentAt])
  @@index([recipientUserId, createdAt])
  @@index([status, lockedBy])
  @@map("email_delivery")
}

model EmailWorkerLease {
  name        String   @id
  ownerId     String?
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt

  @@map("email_worker_lease")
}

model StudentProfile {
  userId    String   @id
  phone     String   @default("")
  kakao     String   @default("")
  github    String   @default("")
  instagram String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profile")
}

model AuditLog {
  id         String         @id @default(uuid())
  actorKind  AuditActorKind @default(USER)
  actorId    String?
  action     AuditAction
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime       @default(now())
  actor      User?          @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_log")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ProfessorAllowlist {
  id          String    @id @default(uuid())
  email       String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdBy   User      @relation("AllowlistCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("professor_allowlist")
}

model ProjectProgram {
  id                            String                    @id @default(uuid())
  createdById                   String?
  name                          String
  category                      String
  startsAt                      DateTime
  endsAt                        DateTime
  projectRegistrationStartsAt   DateTime
  projectRegistrationEndsAt     DateTime
  recruitmentStartsAt           DateTime?
  recruitmentEndsAt             DateTime?
  executionStartsAt             DateTime
  executionEndsAt               DateTime
  advisorEnabled                Boolean                   @default(true)
  studentProjectCreationEnabled Boolean                   @default(false)
  projectTeamMinSize            Int                       @default(2)
  projectTeamMaxSize            Int                       @default(6)
  icon                          ProgramIcon               @default(FOLDER)
  isPublic                      Boolean                   @default(false)
  firstPublishedAt              DateTime?
  endProcessedAt                DateTime?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  createdBy                     User?                     @relation(fields: [createdById], references: [id])
  topics                        Topic[]
  votingPolicy                  ProgramVotingPolicy?
  votes                         ProjectVote[]
  divisions                     ProgramDivision[]
  reportDefinitions             ProgramReportDefinition[]
  rubricDefinitions             RubricDefinition[]
  announcements                 Announcement[]
  managers                      ProgramManager[]

  @@unique([name, startsAt])
  @@index([endsAt, endProcessedAt])
  @@index([isPublic, startsAt, endsAt])
  @@map("project_program")
}

model ProgramDivision {
  id                String             @id @default(uuid())
  programId         String
  name              String
  position          Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  program           ProjectProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  topics            Topic[]
  rubricDefinitions RubricDefinition[]

  @@unique([programId, name])
  @@unique([id, programId])
  @@unique([programId, position])
  @@index([programId, position])
  @@map("program_track")
}

model ProgramReportDefinition {
  id         String         @id @default(uuid())
  programId  String
  title      String
  dueAt      DateTime
  required   Boolean        @default(true)
  position   Int            @default(0)
  archivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  program    ProjectProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  reports    Report[]

  @@unique([id, programId])
  @@index([programId, archivedAt, position])
  @@map("program_report_definition")
}

model RubricDefinition {
  id                 String                        @id @default(uuid())
  programId          String
  divisionId         String?
  title              String
  gradingDueAt       DateTime
  position           Int                           @default(0)
  audience           RubricAudience                @default(STAFF_ONLY)
  archivedAt         DateTime?
  legacy             Boolean                       @default(false)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  program            ProjectProgram                @relation(fields: [programId], references: [id], onDelete: Cascade)
  division           ProgramDivision?              @relation(fields: [divisionId, programId], references: [id, programId], onDelete: Restrict)
  criteria           RubricCriterion[]
  evaluations        ProjectTeamRubricEvaluation[]
  advisorEvaluations AdvisorEvaluation[]

  @@unique([id, programId])
  @@index([programId, divisionId, archivedAt, position])
  @@map("rubric_definition")
}

model RubricCriterion {
  id            String           @id @default(uuid())
  rubricId      String
  label         String
  maxPoints     Int              @default(10)
  position      Int              @default(0)
  createdAt     DateTime         @default(now())
  rubric        RubricDefinition @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores        RubricScore[]
  advisorScores AdvisorScore[]

  @@index([rubricId, position])
  @@map("rubric_criterion")
}

model ProjectTeamRubricEvaluation {
  id                  String           @id @default(uuid())
  projectTeamId       String
  rubricId            String
  legacyMemberVisible Boolean?
  createdAt           DateTime         @default(now())
  projectTeam         ProjectTeam      @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  rubric              RubricDefinition @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  scores              RubricScore[]

  @@unique([projectTeamId, rubricId])
  @@index([projectTeamId])
  @@index([rubricId])
  @@map("project_team_rubric_evaluation")
}

model RubricScore {
  id           String                      @id @default(uuid())
  evaluationId String
  criterionId  String
  points       Int
  scoredByName String
  updatedAt    DateTime                    @updatedAt
  evaluation   ProjectTeamRubricEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion             @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
  @@map("rubric_score")
}

enum ProgramIcon {
  FOLDER
  GRADUATION_CAP
  TROPHY
  CODE
  FLASK
  PALETTE
  ROCKET
  BRIEFCASE
  GLOBE
  USERS
  BOOK_OPEN
  HANDSHAKE
}

enum VoteLimitScope {
  PROGRAM
  DIVISION
}

model Topic {
  id                      String                       @id @default(uuid())
  programId               String
  divisionId              String?                      @map("trackId")
  authorId                String
  managerId               String?
  title                   String
  description             String
  advisorRole             String                       @default("교수")
  requiredSkills          String[]                     @default(["별도 협의"])
  preferredSkills         String[]                     @default([])
  roleExpectations        String                       @default("세부 역할 별도 협의")
  availabilityRequirement String                       @default("활동 가능 시간 별도 협의")
  applicationMode         TopicApplicationMode         @default(INDIVIDUAL_ONLY)
  recruitmentEnabled      Boolean                      @default(true)
  capacity                Int
  status                  TopicStatus
  publishedAt             DateTime?
  sourceUrl               String?
  thumbnailPath           String?
  posterPath              String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  program                 ProjectProgram               @relation(fields: [programId], references: [id])
  division                ProgramDivision?             @relation(fields: [divisionId, programId], references: [id, programId], onDelete: Restrict)
  author                  User                         @relation("TopicAuthor", fields: [authorId], references: [id])
  manager                 User?                        @relation("TopicManager", fields: [managerId], references: [id], onDelete: Restrict)
  applications            TopicApplication[]
  applicationQuestions    TopicApplicationQuestion[]
  applicationGroups       TopicApplicationGroup[]
  projectTeam             ProjectTeam?
  approvalRequests        TopicApprovalRequest[]
  assistants              ProjectAssistant[]
  assistantInvitations    ProjectAssistantInvitation[]
  votes                   ProjectVote[]
  advisors                ProjectAdvisor[]

  @@unique([id, programId])
  @@index([programId, status])
  @@index([programId, divisionId])
  @@index([authorId])
  @@index([managerId, status])
  @@map("topic")
}

model ProgramVotingPolicy {
  programId                  String         @id
  startsAt                   DateTime
  endsAt                     DateTime
  voteLimit                  Int
  staffVoteLimit             Int            @default(5)
  voteLimitScope             VoteLimitScope @default(PROGRAM)
  selfVotingAllowed          Boolean        @default(false)
  resultsVisibleDuringVoting Boolean        @default(false)
  resultsVisibleAfterVoting  Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  program                    ProjectProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_voting_policy")
}

model ProjectVote {
  id        String         @id @default(uuid())
  programId String
  topicId   String
  voterId   String
  createdAt DateTime       @default(now())
  program   ProjectProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  topic     Topic          @relation(fields: [topicId, programId], references: [id, programId], onDelete: Cascade)
  voter     User           @relation(fields: [voterId], references: [id], onDelete: Restrict)

  @@unique([programId, voterId, topicId])
  @@index([programId, topicId])
  @@index([programId, voterId])
  @@map("project_vote")
}

model ProjectAssistant {
  id          String   @id @default(uuid())
  topicId     String
  userId      String
  grantedById String
  createdAt   DateTime @default(now())
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user        User     @relation("ProjectAssistantUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy   User     @relation("ProjectAssistantGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([topicId, userId])
  @@index([userId, createdAt])
  @@map("project_assistant")
}

model ProjectAssistantInvitation {
  id          String                           @id @default(uuid())
  topicId     String
  inviteeId   String
  inviterId   String
  status      ProjectAssistantInvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  topic       Topic                            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  invitee     User                             @relation("ProjectAssistantInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  inviter     User                             @relation("ProjectAssistantInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([topicId, status, createdAt])
  @@index([inviteeId, status, createdAt])
  @@map("project_assistant_invitation")
}

model AdvisorAccessToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("advisor_access_token")
}

model ProjectAdvisor {
  id          String   @id @default(uuid())
  topicId     String
  userId      String
  grantedById String
  createdAt   DateTime @default(now())
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user        User     @relation("ProjectAdvisorUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation("ProjectAdvisorGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([topicId, userId])
  @@index([userId, createdAt])
  @@map("project_advisor")
}

model AdvisorEvaluation {
  id            String           @id @default(uuid())
  projectTeamId String
  advisorId     String
  rubricId      String
  createdAt     DateTime         @default(now())
  projectTeam   ProjectTeam      @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  advisor       User             @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  rubric        RubricDefinition @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  scores        AdvisorScore[]

  @@unique([projectTeamId, advisorId, rubricId])
  @@index([projectTeamId])
  @@map("advisor_evaluation")
}

model AdvisorScore {
  id           String            @id @default(uuid())
  evaluationId String
  criterionId  String
  points       Int
  updatedAt    DateTime          @updatedAt
  evaluation   AdvisorEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    RubricCriterion   @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@map("advisor_score")
}

model AdvisorFeedback {
  id            String      @id @default(uuid())
  projectTeamId String
  advisorId     String
  body          String
  createdAt     DateTime    @default(now())
  projectTeam   ProjectTeam @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  advisor       User        @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([projectTeamId, createdAt])
  @@map("advisor_feedback")
}

model TopicApplication {
  id                     String                          @id @default(uuid())
  topicId                String
  studentId              String
  groupId                String?
  participantRole        TopicApplicationParticipantRole @default(LEADER)
  message                String
  skills                 String[]                        @default(["기존 지원서 미입력"])
  desiredRole            String                          @default("기존 지원서 미입력")
  availability           String                          @default("기존 지원서 미입력")
  status                 TopicApplicationStatus          @default(PENDING)
  reviewComment          String                          @default("")
  decidedById            String?
  decidedAt              DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  topic                  Topic                           @relation(fields: [topicId], references: [id])
  student                User                            @relation(fields: [studentId], references: [id])
  decidedBy              User?                           @relation("TopicApplicationDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  group                  TopicApplicationGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  projectTeamMembership  ProjectTeamMembership?
  recruitmentApplication RecruitmentApplication?

  @@unique([topicId, studentId])
  @@unique([id, studentId, topicId])
  @@index([studentId, status])
  @@index([decidedById, decidedAt])
  @@index([groupId, participantRole])
  @@map("topic_application")
}

model TopicApplicationQuestion {
  id        String                   @id @default(uuid())
  topicId   String
  label     String
  maxLength Int
  required  Boolean                  @default(true)
  position  Int
  topic     Topic                    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers   TopicApplicationAnswer[]

  @@unique([topicId, position])
  @@index([topicId])
  @@map("topic_application_question")
}

model TopicApplicationGroup {
  id            String                   @id @default(uuid())
  topicId       String
  leaderId      String
  studentTeamId String?
  kind          TopicApplicationKind
  createdAt     DateTime                 @default(now())
  topic         Topic                    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  leader        User                     @relation("TopicApplicationGroupLeader", fields: [leaderId], references: [id])
  studentTeam   StudentTeam?             @relation(fields: [studentTeamId], references: [id], onDelete: SetNull)
  applications  TopicApplication[]
  answers       TopicApplicationAnswer[]

  @@index([topicId, createdAt])
  @@index([leaderId, createdAt])
  @@index([studentTeamId, createdAt])
  @@map("topic_application_group")
}

model TopicApprovalRequest {
  id                   String              @id @default(uuid())
  topicId              String
  requesterId          String
  route                TopicApprovalRoute
  requestedProfessorId String?
  status               TopicApprovalStatus @default(PENDING)
  reviewComment        String              @default("")
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  topic                Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  requester            User                @relation("TopicApprovalRequester", fields: [requesterId], references: [id])
  requestedProfessor   User?               @relation("TopicApprovalProfessor", fields: [requestedProfessorId], references: [id])
  decidedBy            User?               @relation("TopicApprovalDecider", fields: [decidedById], references: [id])

  @@index([status, route, createdAt])
  @@index([requestedProfessorId, status])
  @@index([requesterId, createdAt])
  @@index([topicId, status, createdAt])
  @@map("topic_approval_request")
}

model TopicApplicationAnswer {
  id         String                   @id @default(uuid())
  groupId    String
  questionId String
  value      String
  group      TopicApplicationGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question   TopicApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([groupId, questionId])
  @@index([questionId])
  @@map("topic_application_answer")
}

model ProjectTeam {
  id                 String                        @id @default(uuid())
  projectId          String                        @unique
  name               String
  confirmedAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  project            Topic                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships        ProjectTeamMembership[]
  invitations        ProjectTeamInvitation[]
  tasks              Task[]
  progressUpdates    ProgressUpdate[]
  discussionPosts    DiscussionPost[]
  storedFiles        StoredFile[]
  reports            Report[]
  rubricEvaluations  ProjectTeamRubricEvaluation[]
  artifacts          Artifact[]
  recruitmentPosts   RecruitmentPost[]
  guidanceRequests   ProjectGuidanceRequest[]
  announcements      Announcement[]
  showcaseIntro      String?
  // 오프라인 심사로 정해지는 수상 내역. 이전 시스템에서 옮겨 온 값도 여기에 들어간다.
  award              String?
  // 이전 시스템에서 옮겨 온 득표수. 투표 이력이 없어 집계할 수 없으므로 값만 보관한다.
  archivedVoteCount  Int?
  advisorEvaluations AdvisorEvaluation[]
  advisorFeedbacks   AdvisorFeedback[]

  @@index([confirmedAt])
  @@map("project_team")
}

model ProjectGuidanceRequest {
  id            String                       @id @default(uuid())
  projectTeamId String
  requesterId   String
  kind          ProjectGuidanceRequestKind
  title         String
  content       String
  referenceUrl  String?
  preferredAt   DateTime?
  status        ProjectGuidanceRequestStatus @default(PENDING)
  response      String?
  scheduledAt   DateTime?
  responderId   String?
  respondedAt   DateTime?
  canceledAt    DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  projectTeam   ProjectTeam                  @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  requester     User                         @relation("ProjectGuidanceRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  responder     User?                        @relation("ProjectGuidanceResponder", fields: [responderId], references: [id], onDelete: Restrict)

  @@index([projectTeamId, status, createdAt])
  @@index([requesterId, createdAt])
  @@map("project_guidance_request")
}

model StudentTeam {
  id                 String                       @id @default(uuid())
  name               String
  description        String                       @default("")
  leaderId           String
  compositionVersion Int                          @default(1)
  deletedAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  leader             User                         @relation("StudentTeamLeader", fields: [leaderId], references: [id])
  members            StudentTeamMember[]
  applicationGroups  TopicApplicationGroup[]
  invitations        StudentTeamInvitation[]
  recruitmentPosts   StudentTeamRecruitmentPost[]

  @@index([leaderId, deletedAt])
  @@index([deletedAt, updatedAt])
  @@map("student_team")
}

model StudentTeamMember {
  id        String                @id @default(uuid())
  teamId    String
  studentId String
  role      StudentTeamMemberRole @default(MEMBER)
  joinedAt  DateTime              @default(now())
  team      StudentTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student   User                  @relation(fields: [studentId], references: [id])

  @@unique([teamId, studentId])
  @@index([studentId, joinedAt])
  @@map("student_team_member")
}

// 확정된 프로젝트 팀에 뒤늦게 사람을 들이는 통로. 사전 팀 초대와 같은 모양이지만
// 붙는 곳이 다르다. 저쪽은 프로젝트 전 단계의 팀이고 이쪽은 이미 굴러가는 프로젝트다.
model ProjectTeamInvitation {
  id            String                      @id @default(uuid())
  projectTeamId String
  email         String
  inviteeId     String?
  invitedById   String
  status        ProjectTeamInvitationStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  projectTeam   ProjectTeam                 @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  invitee       User?                       @relation("ProjectTeamInvitee", fields: [inviteeId], references: [id])
  invitedBy     User                        @relation("ProjectTeamInviter", fields: [invitedById], references: [id])

  @@unique([projectTeamId, email])
  @@index([email, status, createdAt])
  @@index([inviteeId, status])
  @@map("project_team_invitation")
}

model StudentTeamInvitation {
  id          String                      @id @default(uuid())
  teamId      String
  email       String
  inviteeId   String?
  invitedById String
  status      StudentTeamInvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  team        StudentTeam                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitee     User?                       @relation("StudentTeamInvitee", fields: [inviteeId], references: [id])
  invitedBy   User                        @relation("StudentTeamInviter", fields: [invitedById], references: [id])

  @@unique([teamId, email])
  @@index([email, status, createdAt])
  @@index([inviteeId, status])
  @@map("student_team_invitation")
}

model StudentTeamRecruitmentPost {
  id             String                              @id @default(uuid())
  teamId         String
  authorId       String
  title          String
  content        String
  requiredSkills String[]                            @default([])
  roleNeeded     String
  availability   String
  capacity       Int
  status         RecruitmentPostStatus               @default(OPEN)
  deadlineAt     DateTime
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  team           StudentTeam                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author         User                                @relation("StudentTeamRecruitmentAuthor", fields: [authorId], references: [id])
  applications   StudentTeamRecruitmentApplication[]

  @@index([status, deadlineAt])
  @@index([teamId, status])
  @@map("student_team_recruitment_post")
}

model StudentTeamRecruitmentApplication {
  id             String                       @id @default(uuid())
  postId         String
  studentId      String
  message        String
  desiredRole    String
  sharedContacts Json                         @default("{}")
  status         RecruitmentApplicationStatus @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  post           StudentTeamRecruitmentPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  student        User                         @relation("StudentTeamRecruitmentApplicant", fields: [studentId], references: [id])

  @@unique([postId, studentId])
  @@index([studentId, status])
  @@map("student_team_recruitment_application")
}

model RecruitmentPost {
  id             String                   @id @default(uuid())
  projectTeamId  String
  authorId       String
  title          String
  content        String
  requiredSkills String[]                 @default([])
  roleNeeded     String
  availability   String
  status         RecruitmentPostStatus    @default(OPEN)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  projectTeam    ProjectTeam              @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  author         User                     @relation(fields: [authorId], references: [id])
  applications   RecruitmentApplication[]

  @@index([status, createdAt])
  @@index([projectTeamId, status])
  @@map("recruitment_post")
}

model RecruitmentApplication {
  id                 String                       @id @default(uuid())
  postId             String
  topicApplicationId String                       @unique
  studentId          String
  status             RecruitmentApplicationStatus @default(PENDING)
  decidedAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  post               RecruitmentPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  topicApplication   TopicApplication             @relation(fields: [topicApplicationId], references: [id], onDelete: Cascade)
  student            User                         @relation(fields: [studentId], references: [id])

  @@unique([postId, studentId])
  @@index([studentId, status])
  @@map("recruitment_application")
}

model ProjectTeamMembership {
  id                  String                          @id @default(uuid())
  projectTeamId       String
  userId              String
  sourceApplicationId String?                         @unique
  role                ProjectTeamMembershipRole       @default(MEMBER)
  joinedAt            DateTime                        @default(now())
  endedAt             DateTime?
  endReason           ProjectTeamMembershipEndReason?
  projectTeam         ProjectTeam                     @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  user                User                            @relation(fields: [userId], references: [id])
  sourceApplication   TopicApplication?               @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)

  @@index([projectTeamId, userId])
  @@index([userId, endedAt])
  @@map("project_team_membership")
}

model Task {
  id            String         @id @default(uuid())
  projectTeamId String
  createdById   String
  title         String
  dueAt         DateTime
  status        TaskStatus     @default(TODO)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectTeam   ProjectTeam    @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id])
  assignees     TaskAssignee[]

  @@index([projectTeamId, dueAt])
  @@map("task")
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignee")
}

model ProgressUpdate {
  id            String      @id @default(uuid())
  projectTeamId String
  authorId      String
  content       String
  risk          String
  nextAction    String
  createdAt     DateTime    @default(now())
  projectTeam   ProjectTeam @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id])

  @@index([projectTeamId, createdAt])
  @@map("progress_update")
}

model DiscussionPost {
  id            String      @id @default(uuid())
  projectTeamId String
  authorId      String
  content       String
  createdAt     DateTime    @default(now())
  projectTeam   ProjectTeam @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id])

  @@index([projectTeamId, createdAt])
  @@index([authorId])
  @@map("discussion_post")
}

model StoredFile {
  id                     String                  @id @default(uuid())
  projectTeamId          String?
  ownerId                String
  purpose                FilePurpose
  consumer               UploadConsumer
  status                 StoredFileStatus        @default(PENDING)
  objectKey              String                  @unique
  uploadObjectKey        String                  @unique
  originalName           String
  contentType            String
  size                   Int
  sha256                 String
  expiresAt              DateTime
  cleanupAfter           DateTime
  createdAt              DateTime                @default(now())
  readyAt                DateTime?
  projectTeam            ProjectTeam?            @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  owner                  User                    @relation(fields: [ownerId], references: [id])
  reportVersion          ReportVersion?
  artifact               Artifact?
  announcementAttachment AnnouncementAttachment?

  @@index([projectTeamId, status])
  @@index([status, cleanupAfter])
  @@map("stored_file")
}

model UserProfileImage {
  userId      String   @id
  objectKey   String   @unique
  contentType String
  size        Int
  sha256      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_image")
}

model ProfileImageUpload {
  id              String   @id @default(uuid())
  ownerId         String
  objectKey       String   @unique
  uploadObjectKey String   @unique
  originalName    String
  contentType     String
  size            Int
  sha256          String
  expiresAt       DateTime
  cleanupAfter    DateTime
  createdAt       DateTime @default(now())
  owner           User     @relation("ProfileImageUploadOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, cleanupAfter])
  @@index([cleanupAfter])
  @@map("profile_image_upload")
}

model ObjectDeletionJob {
  id            String    @id @default(uuid())
  objectKey     String    @unique
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?

  @@index([nextAttemptAt, lockedAt])
  @@map("object_deletion_job")
}

model Report {
  id                String                  @id @default(uuid())
  projectTeamId     String
  definitionId      String
  titleSnapshot     String
  dueAt             DateTime
  required          Boolean                 @default(true)
  submissionEnabled Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  projectTeam       ProjectTeam             @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  definition        ProgramReportDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  versions          ReportVersion[]
  feedback          ReportFeedback[]

  @@unique([projectTeamId, definitionId])
  @@index([projectTeamId, required, dueAt])
  @@index([definitionId])
  @@map("report")
}

model ReportFeedback {
  id        String   @id @default(uuid())
  reportId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User     @relation("ReportFeedbackAuthor", fields: [authorId], references: [id])

  @@index([reportId, createdAt])
  @@map("report_feedback")
}

model ReportVersion {
  id          String            @id @default(uuid())
  reportId    String
  version     Int
  fileId      String            @unique
  submitterId String
  description String
  submittedAt DateTime          @default(now())
  report      Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  file        StoredFile        @relation(fields: [fileId], references: [id], onDelete: NoAction)
  submitter   User              @relation(fields: [submitterId], references: [id])
  decision    ApprovalDecision?

  @@unique([reportId, version])
  @@index([submitterId])
  @@map("report_version")
}

model ApprovalDecision {
  id              String               @id @default(uuid())
  reportVersionId String               @unique
  reviewerId      String
  decision        ApprovalDecisionType
  comment         String
  decidedAt       DateTime             @default(now())
  reportVersion   ReportVersion        @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  reviewer        User                 @relation(fields: [reviewerId], references: [id])

  @@index([reviewerId])
  @@map("approval_decision")
}

model Artifact {
  id             String       @id @default(uuid())
  projectTeamId  String
  registeredById String
  type           ArtifactType
  title          String
  fileId         String?      @unique
  externalUrl    String?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  projectTeam    ProjectTeam  @relation(fields: [projectTeamId], references: [id], onDelete: Cascade)
  registeredBy   User         @relation(fields: [registeredById], references: [id])
  file           StoredFile?  @relation(fields: [fileId], references: [id], onDelete: NoAction)

  @@index([projectTeamId, createdAt])
  @@map("artifact")
}

model FeedbackPost {
  id             String                 @id @default(uuid())
  authorName     String
  targetScreen   FeedbackTargetScreen
  area           String
  type           FeedbackType
  priority       FeedbackPriority       @default(NORMAL)
  title          String
  body           String
  status         FeedbackStatus         @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedByName String?
  createdAt      DateTime               @default(now())
  comments       FeedbackComment[]
  statusChanges  FeedbackStatusChange[]
  resolvedBy     User?                  @relation("FeedbackPostResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@map("feedback_post")
}

model FeedbackStatusChange {
  id            String         @id @default(uuid())
  postId        String
  status        FeedbackStatus
  changedById   String?
  changedByName String
  note          String?
  createdAt     DateTime       @default(now())
  post          FeedbackPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  changedBy     User?          @relation("FeedbackStatusChangeActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@map("feedback_status_change")
}

model FeedbackComment {
  id         String       @id @default(uuid())
  postId     String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime     @default(now())
  post       FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User?        @relation("FeedbackCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@map("feedback_comment")
}
