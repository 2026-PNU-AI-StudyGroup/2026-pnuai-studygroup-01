generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
}

enum AcademicTerm {
  FIRST
  SECOND
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum TopicApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TopicApplicationMode {
  TEAM_ONLY
  INDIVIDUAL_ONLY
  INDIVIDUAL_OR_TEAM
}

enum TopicApplicationKind {
  INDIVIDUAL
  TEAM
}

enum TopicApplicationParticipantRole {
  LEADER
  MEMBER
}

enum TeamStatus {
  FORMING
  CONFIRMED
  CLOSED
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum StoredFileStatus {
  PENDING
  READY
  ATTACHED
}

enum FilePurpose {
  REPORT
  ARTIFACT
}

enum ReportType {
  START
  MIDTERM
  FINAL
}

enum ApprovalDecisionType {
  APPROVED
  REVISION_REQUESTED
}

enum ArtifactType {
  PRESENTATION_VIDEO
  SOURCE_CODE
  POSTER
  OTHER
}

enum RecruitmentPostStatus {
  OPEN
  CLOSED
}

enum RecruitmentApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum StudentTeamMemberRole {
  LEADER
  MEMBER
}

enum StudentTeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum TopicApprovalRoute {
  PROFESSOR
  ADMIN
}

enum TopicApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectProgramStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AuditAction {
  PROFESSOR_ACCESS_GRANTED
  PROFESSOR_ACCESS_REVOKED
  USER_DEACTIVATED
  USER_REACTIVATED
  TEAM_CONFIRMED
  TEAM_CLOSED
  REPORT_REQUIREMENT_SET
  REPORT_REQUIREMENT_REMOVED
  REPORT_APPROVED
  REPORT_REVISION_REQUESTED
}

enum NotificationType {
  APPLICATION_RESULT
  REPORT_ACTIVITY
  DEADLINE
  SYSTEM
}

enum TranslationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model User {
  id                                 String                              @id
  name                               String
  email                              String                              @unique
  emailVerified                      Boolean                             @default(false)
  image                              String?
  role                               UserRole                            @default(STUDENT)
  isActive                           Boolean                             @default(true)
  preferredLocale                    String                              @default("ko")
  department                         String?
  studentNumber                      String?                             @unique
  grade                              Int?
  phoneNumber                        String?
  contactEmail                       String?
  onboardingRequired                 Boolean                             @default(false)
  onboardingCompletedAt              DateTime?
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  sessions                           Session[]
  accounts                           Account[]
  allowlistEntriesCreated            ProfessorAllowlist[]                @relation("AllowlistCreator")
  topics                             Topic[]
  topicApplications                  TopicApplication[]
  teamMemberships                    TeamMember[]
  milestonesCreated                  Milestone[]                         @relation("MilestoneCreator")
  milestoneAssignments               MilestoneAssignee[]
  progressUpdates                    ProgressUpdate[]
  discussionPosts                    DiscussionPost[]
  storedFiles                        StoredFile[]
  reportVersionsSubmitted            ReportVersion[]
  approvalDecisions                  ApprovalDecision[]
  artifactsRegistered                Artifact[]
  recruitmentPosts                   RecruitmentPost[]
  recruitmentApplications            RecruitmentApplication[]
  projectProgramsCreated             ProjectProgram[]
  auditLogsCreated                   AuditLog[]
  notifications                      Notification[]
  studentProfile                     StudentProfile?
  topicApplicationGroupsLed          TopicApplicationGroup[]             @relation("TopicApplicationGroupLeader")
  studentTeamsLed                    StudentTeam[]                       @relation("StudentTeamLeader")
  studentTeamMemberships             StudentTeamMember[]
  studentTeamInvitations             StudentTeamInvitation[]             @relation("StudentTeamInvitee")
  studentTeamInvitationsSent         StudentTeamInvitation[]             @relation("StudentTeamInviter")
  topicApprovalsRequested            TopicApprovalRequest[]              @relation("TopicApprovalRequester")
  topicApprovalsAssigned             TopicApprovalRequest[]              @relation("TopicApprovalProfessor")
  topicApprovalsDecided              TopicApprovalRequest[]              @relation("TopicApprovalDecider")
  studentTeamRecruitments            StudentTeamRecruitmentPost[]        @relation("StudentTeamRecruitmentAuthor")
  studentTeamRecruitmentApplications StudentTeamRecruitmentApplication[] @relation("StudentTeamRecruitmentApplicant")

  @@map("user")
}

model TranslationSource {
  hash         String               @id
  text         String
  createdAt    DateTime             @default(now())
  translations StoredTranslation[]
  jobs         TranslationJob[]

  @@map("translation_source")
}

model StoredTranslation {
  id           String            @id @default(uuid())
  sourceHash   String
  targetLocale String
  text         String
  model        String
  translatedAt DateTime          @default(now())
  source       TranslationSource @relation(fields: [sourceHash], references: [hash], onDelete: Cascade)

  @@unique([sourceHash, targetLocale])
  @@index([targetLocale, sourceHash])
  @@map("stored_translation")
}

model TranslationJob {
  id           String               @id @default(uuid())
  sourceHash   String
  targetLocale String
  status       TranslationJobStatus @default(PENDING)
  attempts     Int                  @default(0)
  availableAt  DateTime             @default(now())
  lockedAt     DateTime?
  lastError    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  source       TranslationSource    @relation(fields: [sourceHash], references: [hash], onDelete: Cascade)

  @@unique([sourceHash, targetLocale])
  @@index([status, availableAt, createdAt])
  @@map("translation_job")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  type        NotificationType
  title       String
  body        String
  href        String
  dedupeKey   String           @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notification")
}

model StudentProfile {
  userId       String   @id
  interests    String[]
  skills       String[]
  desiredRole  String
  availability String
  bio          String
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profile")
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  action     AuditAction
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime    @default(now())
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_log")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ProfessorAllowlist {
  id          String    @id @default(uuid())
  email       String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdBy   User      @relation("AllowlistCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("professor_allowlist")
}

model AcademicCycle {
  id           String           @id @default(uuid())
  academicYear Int
  term         AcademicTerm
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  topics       Topic[]
  programs     ProjectProgram[]

  @@unique([academicYear, term])
  @@map("academic_cycle")
}

model ProjectProgram {
  id              String               @id @default(uuid())
  academicCycleId String
  createdById     String?
  name            String
  category        String
  description     String
  startsAt        DateTime
  endsAt          DateTime
  status          ProjectProgramStatus @default(DRAFT)
  openedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  academicCycle   AcademicCycle        @relation(fields: [academicCycleId], references: [id])
  createdBy       User?                @relation(fields: [createdById], references: [id])
  topics          Topic[]

  @@unique([academicCycleId, name])
  @@unique([id, academicCycleId])
  @@index([status, startsAt, endsAt])
  @@map("project_program")
}

model Topic {
  id                      String                     @id @default(uuid())
  academicCycleId         String
  programId               String
  authorId                String
  title                   String
  description             String
  advisorRole             String                     @default("교수")
  requiredSkills          String[]                   @default(["별도 협의"])
  preferredSkills         String[]                   @default([])
  roleExpectations        String                     @default("세부 역할 별도 협의")
  availabilityRequirement String                     @default("활동 가능 시간 별도 협의")
  applicationMode         TopicApplicationMode       @default(INDIVIDUAL_ONLY)
  recruitmentEnabled      Boolean                    @default(true)
  capacity                Int
  recruitmentStartsAt     DateTime
  recruitmentEndsAt       DateTime
  executionStartsAt       DateTime
  executionEndsAt         DateTime
  submissionStartsAt      DateTime
  submissionEndsAt        DateTime
  status                  TopicStatus                @default(DRAFT)
  publishedAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  academicCycle           AcademicCycle              @relation(fields: [academicCycleId], references: [id])
  program                 ProjectProgram             @relation(fields: [programId, academicCycleId], references: [id, academicCycleId])
  author                  User                       @relation(fields: [authorId], references: [id])
  applications            TopicApplication[]
  applicationQuestions    TopicApplicationQuestion[]
  applicationGroups       TopicApplicationGroup[]
  team                    Team?
  approvalRequest         TopicApprovalRequest?

  @@unique([id, academicCycleId, authorId])
  @@index([academicCycleId, status])
  @@index([programId, status])
  @@index([authorId])
  @@map("topic")
}

model TopicApplication {
  id                     String                          @id @default(uuid())
  topicId                String
  studentId              String
  groupId                String?
  participantRole        TopicApplicationParticipantRole @default(LEADER)
  message                String
  skills                 String[]                        @default(["기존 지원서 미입력"])
  desiredRole            String                          @default("기존 지원서 미입력")
  availability           String                          @default("기존 지원서 미입력")
  status                 TopicApplicationStatus          @default(PENDING)
  reviewComment          String                          @default("")
  decidedAt              DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  topic                  Topic                           @relation(fields: [topicId], references: [id])
  student                User                            @relation(fields: [studentId], references: [id])
  group                  TopicApplicationGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamMember             TeamMember?
  recruitmentApplication RecruitmentApplication?

  @@unique([topicId, studentId])
  @@unique([id, studentId, topicId])
  @@index([studentId, status])
  @@index([groupId, participantRole])
  @@map("topic_application")
}

model TopicApplicationQuestion {
  id           String                       @id @default(uuid())
  topicId      String
  label        String
  maxLength    Int
  required     Boolean                      @default(true)
  position     Int
  topic        Topic                        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers      TopicApplicationAnswer[]

  @@unique([topicId, position])
  @@index([topicId])
  @@map("topic_application_question")
}

model TopicApplicationGroup {
  id            String                   @id @default(uuid())
  topicId       String
  leaderId      String
  kind          TopicApplicationKind
  createdAt     DateTime                 @default(now())
  topic         Topic                    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  leader        User                     @relation("TopicApplicationGroupLeader", fields: [leaderId], references: [id])
  studentTeamId String?
  studentTeam   StudentTeam?             @relation(fields: [studentTeamId], references: [id], onDelete: SetNull)
  applications  TopicApplication[]
  answers       TopicApplicationAnswer[]

  @@index([topicId, createdAt])
  @@index([leaderId, createdAt])
  @@index([studentTeamId, createdAt])
  @@map("topic_application_group")
}

model TopicApprovalRequest {
  id                   String              @id @default(uuid())
  topicId              String              @unique
  requesterId          String
  route                TopicApprovalRoute
  requestedProfessorId String?
  studentTeamId        String?
  status               TopicApprovalStatus @default(PENDING)
  reviewComment        String              @default("")
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  topic                Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  requester            User                @relation("TopicApprovalRequester", fields: [requesterId], references: [id])
  requestedProfessor   User?               @relation("TopicApprovalProfessor", fields: [requestedProfessorId], references: [id])
  studentTeam          StudentTeam?         @relation(fields: [studentTeamId], references: [id], onDelete: SetNull)
  decidedBy            User?               @relation("TopicApprovalDecider", fields: [decidedById], references: [id])

  @@index([status, route, createdAt])
  @@index([requestedProfessorId, status])
  @@index([requesterId, createdAt])
  @@index([studentTeamId])
  @@map("topic_approval_request")
}

model TopicApplicationAnswer {
  id         String                   @id @default(uuid())
  groupId    String
  questionId String
  value      String
  group      TopicApplicationGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question   TopicApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([groupId, questionId])
  @@index([questionId])
  @@map("topic_application_answer")
}

model Team {
  id               String            @id @default(uuid())
  academicCycleId  String
  topicId          String            @unique
  professorId      String
  name             String
  sourceUrl        String?
  thumbnailPath    String?
  posterPath       String?
  status           TeamStatus        @default(FORMING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  topic            Topic             @relation(fields: [topicId, academicCycleId, professorId], references: [id, academicCycleId, authorId])
  members          TeamMember[]
  milestones       Milestone[]
  progressUpdates  ProgressUpdate[]
  discussionPosts  DiscussionPost[]
  storedFiles      StoredFile[]
  reports          Report[]
  artifacts        Artifact[]
  recruitmentPosts RecruitmentPost[]

  @@unique([topicId, academicCycleId, professorId])
  @@unique([id, academicCycleId, topicId])
  @@index([academicCycleId, status])
  @@index([professorId])
  @@map("team")
}

model StudentTeam {
  id                String                       @id @default(uuid())
  name              String
  description       String                       @default("")
  leaderId          String
  deletedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  leader            User                         @relation("StudentTeamLeader", fields: [leaderId], references: [id])
  members           StudentTeamMember[]
  invitations       StudentTeamInvitation[]
  recruitmentPosts  StudentTeamRecruitmentPost[]
  applicationGroups TopicApplicationGroup[]
  proposalRequests  TopicApprovalRequest[]

  @@index([leaderId, deletedAt])
  @@index([deletedAt, updatedAt])
  @@map("student_team")
}

model StudentTeamMember {
  id        String                @id @default(uuid())
  teamId    String
  studentId String
  role      StudentTeamMemberRole @default(MEMBER)
  joinedAt  DateTime              @default(now())
  team      StudentTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student   User                  @relation(fields: [studentId], references: [id])

  @@unique([teamId, studentId])
  @@index([studentId, joinedAt])
  @@map("student_team_member")
}

model StudentTeamInvitation {
  id          String                      @id @default(uuid())
  teamId      String
  email       String
  inviteeId   String?
  invitedById String
  status      StudentTeamInvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  team        StudentTeam                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitee     User?                       @relation("StudentTeamInvitee", fields: [inviteeId], references: [id])
  invitedBy   User                        @relation("StudentTeamInviter", fields: [invitedById], references: [id])

  @@unique([teamId, email])
  @@index([email, status, createdAt])
  @@index([inviteeId, status])
  @@map("student_team_invitation")
}

model StudentTeamRecruitmentPost {
  id             String                              @id @default(uuid())
  teamId         String
  authorId       String
  title          String
  content        String
  requiredSkills String[]                            @default([])
  roleNeeded     String
  availability   String
  capacity       Int
  status         RecruitmentPostStatus               @default(OPEN)
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  team           StudentTeam                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author         User                                @relation("StudentTeamRecruitmentAuthor", fields: [authorId], references: [id])
  applications   StudentTeamRecruitmentApplication[]

  @@index([status, createdAt])
  @@index([teamId, status])
  @@map("student_team_recruitment_post")
}

model StudentTeamRecruitmentApplication {
  id           String                       @id @default(uuid())
  postId       String
  studentId    String
  message      String
  skills       String[]                     @default([])
  desiredRole  String
  availability String
  status       RecruitmentApplicationStatus @default(PENDING)
  decidedAt    DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  post         StudentTeamRecruitmentPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  student      User                         @relation("StudentTeamRecruitmentApplicant", fields: [studentId], references: [id])

  @@unique([postId, studentId])
  @@index([studentId, status])
  @@map("student_team_recruitment_application")
}

model RecruitmentPost {
  id             String                   @id @default(uuid())
  teamId         String
  authorId       String
  title          String
  content        String
  requiredSkills String[]                 @default([])
  roleNeeded     String
  availability   String
  status         RecruitmentPostStatus    @default(OPEN)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  team           Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author         User                     @relation(fields: [authorId], references: [id])
  applications   RecruitmentApplication[]

  @@index([status, createdAt])
  @@index([teamId, status])
  @@map("recruitment_post")
}

model RecruitmentApplication {
  id                 String                       @id @default(uuid())
  postId             String
  topicApplicationId String                       @unique
  studentId          String
  status             RecruitmentApplicationStatus @default(PENDING)
  decidedAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  post               RecruitmentPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  topicApplication   TopicApplication             @relation(fields: [topicApplicationId], references: [id], onDelete: Cascade)
  student            User                         @relation(fields: [studentId], references: [id])

  @@unique([postId, studentId])
  @@index([studentId, status])
  @@map("recruitment_application")
}

model TeamMember {
  id              String           @id @default(uuid())
  teamId          String
  academicCycleId String
  topicId         String
  studentId       String
  applicationId   String           @unique
  joinedAt        DateTime         @default(now())
  team            Team             @relation(fields: [teamId, academicCycleId, topicId], references: [id, academicCycleId, topicId], onDelete: Cascade)
  student         User             @relation(fields: [studentId], references: [id])
  application     TopicApplication @relation(fields: [applicationId, studentId, topicId], references: [id, studentId, topicId])

  @@unique([teamId, studentId])
  @@unique([academicCycleId, studentId])
  @@unique([applicationId, studentId, topicId])
  @@index([studentId])
  @@map("team_member")
}

model Milestone {
  id          String              @id @default(uuid())
  teamId      String
  createdById String
  title       String
  dueAt       DateTime
  status      MilestoneStatus     @default(TODO)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("MilestoneCreator", fields: [createdById], references: [id])
  assignees   MilestoneAssignee[]

  @@index([teamId, dueAt])
  @@map("milestone")
}

model MilestoneAssignee {
  milestoneId String
  userId      String
  assignedAt  DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([milestoneId, userId])
  @@index([userId])
  @@map("milestone_assignee")
}

model ProgressUpdate {
  id         String   @id @default(uuid())
  teamId     String
  authorId   String
  content    String
  risk       String
  nextAction String
  createdAt  DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])

  @@index([teamId, createdAt])
  @@map("progress_update")
}

model DiscussionPost {
  id        String   @id @default(uuid())
  teamId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([teamId, createdAt])
  @@index([authorId])
  @@map("discussion_post")
}

model StoredFile {
  id              String           @id @default(uuid())
  teamId          String
  ownerId         String
  purpose         FilePurpose
  status          StoredFileStatus @default(PENDING)
  objectKey       String           @unique
  uploadObjectKey String           @unique
  originalName    String
  contentType     String
  size            Int
  sha256          String
  expiresAt       DateTime
  cleanupAfter    DateTime
  createdAt       DateTime         @default(now())
  readyAt         DateTime?
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner           User             @relation(fields: [ownerId], references: [id])
  reportVersion   ReportVersion?
  artifact        Artifact?

  @@index([teamId, status])
  @@index([status, cleanupAfter])
  @@map("stored_file")
}

model ObjectDeletionJob {
  id            String    @id @default(uuid())
  objectKey     String    @unique
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?

  @@index([nextAttemptAt, lockedAt])
  @@map("object_deletion_job")
}

model Report {
  id        String          @id @default(uuid())
  teamId    String
  type      ReportType
  dueAt     DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions  ReportVersion[]

  @@unique([teamId, type])
  @@index([teamId, dueAt])
  @@map("report")
}

model ReportVersion {
  id          String            @id @default(uuid())
  reportId    String
  version     Int
  fileId      String            @unique
  submitterId String
  description String
  submittedAt DateTime          @default(now())
  report      Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  file        StoredFile        @relation(fields: [fileId], references: [id], onDelete: NoAction)
  submitter   User              @relation(fields: [submitterId], references: [id])
  decision    ApprovalDecision?

  @@unique([reportId, version])
  @@index([submitterId])
  @@map("report_version")
}

model ApprovalDecision {
  id              String               @id @default(uuid())
  reportVersionId String               @unique
  reviewerId      String
  decision        ApprovalDecisionType
  comment         String
  decidedAt       DateTime             @default(now())
  reportVersion   ReportVersion        @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  reviewer        User                 @relation(fields: [reviewerId], references: [id])

  @@index([reviewerId])
  @@map("approval_decision")
}

model Artifact {
  id             String       @id @default(uuid())
  teamId         String
  registeredById String
  type           ArtifactType
  title          String
  fileId         String?      @unique
  externalUrl    String?
  createdAt      DateTime     @default(now())
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registeredBy   User         @relation(fields: [registeredById], references: [id])
  file           StoredFile?  @relation(fields: [fileId], references: [id], onDelete: NoAction)

  @@index([teamId, createdAt])
  @@map("artifact")
}
