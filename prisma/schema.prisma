generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
}

enum AcademicTerm {
  FIRST
  SECOND
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum TopicApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamStatus {
  FORMING
  CONFIRMED
  CLOSED
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum StoredFileStatus {
  PENDING
  READY
  ATTACHED
}

enum FilePurpose {
  REPORT
  ARTIFACT
}

enum ReportType {
  START
  MIDTERM
  FINAL
}

enum ApprovalDecisionType {
  APPROVED
  REVISION_REQUESTED
}

enum ArtifactType {
  PRESENTATION_VIDEO
  SOURCE_CODE
  POSTER
  OTHER
}

model User {
  id                      String               @id
  name                    String
  email                   String               @unique
  emailVerified           Boolean              @default(false)
  image                   String?
  role                    UserRole             @default(STUDENT)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  accounts                Account[]
  allowlistEntriesCreated ProfessorAllowlist[] @relation("AllowlistCreator")
  topics                  Topic[]
  topicApplications       TopicApplication[]
  teamMemberships         TeamMember[]
  milestonesCreated       Milestone[]
  progressUpdates         ProgressUpdate[]
  storedFiles             StoredFile[]
  reportVersionsSubmitted ReportVersion[]
  approvalDecisions       ApprovalDecision[]
  artifactsRegistered     Artifact[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ProfessorAllowlist {
  id          String    @id @default(uuid())
  email       String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdBy   User      @relation("AllowlistCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("professor_allowlist")
}

model AcademicCycle {
  id           String       @id @default(uuid())
  academicYear Int
  term         AcademicTerm
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  topics       Topic[]

  @@unique([academicYear, term])
  @@map("academic_cycle")
}

model Topic {
  id                   String        @id @default(uuid())
  academicCycleId      String
  authorId             String
  title                String
  description          String
  capacity             Int
  recruitmentStartsAt  DateTime
  recruitmentEndsAt    DateTime
  executionStartsAt    DateTime
  executionEndsAt      DateTime
  submissionStartsAt   DateTime
  submissionEndsAt     DateTime
  status               TopicStatus   @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  academicCycle        AcademicCycle @relation(fields: [academicCycleId], references: [id])
  author               User          @relation(fields: [authorId], references: [id])
  applications         TopicApplication[]
  team                 Team?

  @@index([academicCycleId, status])
  @@index([authorId])
  @@unique([id, academicCycleId, authorId])
  @@map("topic")
}

model TopicApplication {
  id         String                 @id @default(uuid())
  topicId    String
  studentId  String
  message    String
  status     TopicApplicationStatus @default(PENDING)
  decidedAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  topic      Topic                  @relation(fields: [topicId], references: [id])
  student    User                   @relation(fields: [studentId], references: [id])
  teamMember TeamMember?

  @@unique([topicId, studentId])
  @@unique([id, studentId, topicId])
  @@index([studentId, status])
  @@map("topic_application")
}

model Team {
  id              String        @id @default(uuid())
  academicCycleId String
  topicId         String        @unique
  professorId     String
  name            String
  status          TeamStatus    @default(FORMING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  topic           Topic         @relation(fields: [topicId, academicCycleId, professorId], references: [id, academicCycleId, authorId])
  members         TeamMember[]
  milestones      Milestone[]
  progressUpdates ProgressUpdate[]
  storedFiles     StoredFile[]
  reports         Report[]
  artifacts       Artifact[]

  @@unique([topicId, academicCycleId, professorId])
  @@unique([id, academicCycleId, topicId])
  @@index([academicCycleId, status])
  @@index([professorId])
  @@map("team")
}

model TeamMember {
  id              String         @id @default(uuid())
  teamId          String
  academicCycleId String
  topicId         String
  studentId       String
  applicationId   String         @unique
  joinedAt        DateTime       @default(now())
  team            Team           @relation(fields: [teamId, academicCycleId, topicId], references: [id, academicCycleId, topicId], onDelete: Cascade)
  student         User           @relation(fields: [studentId], references: [id])
  application     TopicApplication @relation(fields: [applicationId, studentId, topicId], references: [id, studentId, topicId])

  @@unique([teamId, studentId])
  @@unique([academicCycleId, studentId])
  @@unique([applicationId, studentId, topicId])
  @@index([studentId])
  @@map("team_member")
}

model Milestone {
  id          String          @id @default(uuid())
  teamId      String
  createdById String
  title       String
  dueAt       DateTime
  status      MilestoneStatus @default(TODO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@index([teamId, dueAt])
  @@map("milestone")
}

model ProgressUpdate {
  id          String   @id @default(uuid())
  teamId      String
  authorId    String
  content     String
  risk        String
  nextAction  String
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([teamId, createdAt])
  @@map("progress_update")
}

model StoredFile {
  id           String           @id @default(uuid())
  teamId       String
  ownerId      String
  purpose      FilePurpose
  status       StoredFileStatus @default(PENDING)
  objectKey    String           @unique
  uploadObjectKey String        @unique
  originalName String
  contentType  String
  size         Int
  sha256       String
  expiresAt    DateTime
  cleanupAfter DateTime
  createdAt    DateTime         @default(now())
  readyAt      DateTime?
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner        User             @relation(fields: [ownerId], references: [id])
  reportVersion ReportVersion?
  artifact     Artifact?

  @@index([teamId, status])
  @@index([status, cleanupAfter])
  @@map("stored_file")
}

model ObjectDeletionJob {
  id         String   @id @default(uuid())
  objectKey  String   @unique
  createdAt  DateTime @default(now())
  attempts   Int      @default(0)
  lastError  String?
  nextAttemptAt DateTime @default(now())
  lockedAt   DateTime?

  @@index([nextAttemptAt, lockedAt])
  @@map("object_deletion_job")
}

model Report {
  id        String      @id @default(uuid())
  teamId    String
  type      ReportType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions  ReportVersion[]

  @@unique([teamId, type])
  @@map("report")
}

model ReportVersion {
  id          String    @id @default(uuid())
  reportId    String
  version     Int
  fileId      String    @unique
  submitterId String
  description String
  submittedAt DateTime  @default(now())
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  file        StoredFile @relation(fields: [fileId], references: [id], onDelete: NoAction)
  submitter   User      @relation(fields: [submitterId], references: [id])
  decision    ApprovalDecision?

  @@unique([reportId, version])
  @@index([submitterId])
  @@map("report_version")
}

model ApprovalDecision {
  id              String               @id @default(uuid())
  reportVersionId String               @unique
  reviewerId      String
  decision        ApprovalDecisionType
  comment         String
  decidedAt       DateTime             @default(now())
  reportVersion   ReportVersion        @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  reviewer        User                 @relation(fields: [reviewerId], references: [id])

  @@index([reviewerId])
  @@map("approval_decision")
}

model Artifact {
  id           String       @id @default(uuid())
  teamId       String
  registeredById String
  type         ArtifactType
  title        String
  fileId       String?      @unique
  externalUrl  String?
  createdAt    DateTime     @default(now())
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registeredBy User         @relation(fields: [registeredById], references: [id])
  file         StoredFile?  @relation(fields: [fileId], references: [id], onDelete: NoAction)

  @@index([teamId, createdAt])
  @@map("artifact")
}
