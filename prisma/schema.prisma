generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
}

enum AcademicTerm {
  FIRST
  SECOND
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum TopicApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                      String               @id
  name                    String
  email                   String               @unique
  emailVerified           Boolean              @default(false)
  image                   String?
  role                    UserRole             @default(STUDENT)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  accounts                Account[]
  allowlistEntriesCreated ProfessorAllowlist[] @relation("AllowlistCreator")
  topics                  Topic[]
  topicApplications       TopicApplication[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ProfessorAllowlist {
  id          String    @id @default(uuid())
  email       String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdBy   User      @relation("AllowlistCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("professor_allowlist")
}

model AcademicCycle {
  id           String       @id @default(uuid())
  academicYear Int
  term         AcademicTerm
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  topics       Topic[]

  @@unique([academicYear, term])
  @@map("academic_cycle")
}

model Topic {
  id                   String        @id @default(uuid())
  academicCycleId      String
  authorId             String
  title                String
  description          String
  capacity             Int
  recruitmentStartsAt  DateTime
  recruitmentEndsAt    DateTime
  executionStartsAt    DateTime
  executionEndsAt      DateTime
  submissionStartsAt   DateTime
  submissionEndsAt     DateTime
  status               TopicStatus   @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  academicCycle        AcademicCycle @relation(fields: [academicCycleId], references: [id])
  author               User          @relation(fields: [authorId], references: [id])
  applications         TopicApplication[]

  @@index([academicCycleId, status])
  @@index([authorId])
  @@map("topic")
}

model TopicApplication {
  id         String                 @id @default(uuid())
  topicId    String
  studentId  String
  message    String
  status     TopicApplicationStatus @default(PENDING)
  decidedAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  topic      Topic                  @relation(fields: [topicId], references: [id])
  student    User                   @relation(fields: [studentId], references: [id])

  @@unique([topicId, studentId])
  @@index([studentId, status])
  @@map("topic_application")
}
