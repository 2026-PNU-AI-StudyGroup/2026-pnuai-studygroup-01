{
  "name": "pnu-project-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "db:generate": "prisma generate",
    "predb:bootstrap-admin": "prisma generate",
    "db:bootstrap-admin": "prisma db seed",
    "db:seed-demo": "tsx scripts/seed-demo-data.ts",
    "db:seed-demo-announcements": "tsx scripts/seed-demo-program-announcements.ts",
    "notifications:deadlines": "tsx scripts/generate-deadline-notifications.ts",
    "emails:process": "tsx scripts/process-email-deliveries.ts",
    "emails:retry-failed": "tsx scripts/retry-failed-email-deliveries.ts",
    "emails:gmail-authorize": "tsx scripts/authorize-gmail-smtp.ts",
    "test:emails:integration": "EMAIL_DELIVERY_INTEGRATION_TEST=true vitest run --maxWorkers=1 src/modules/email/infrastructure/prisma-email-delivery-worker.integration.test.ts",
    "translations:process": "tsx scripts/process-translation-queue.ts",
    "translations:worker": "tsx scripts/process-translation-queue.ts --watch",
    "translations:retry-failed": "tsx scripts/process-translation-queue.ts --retry-failed",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:architecture": "vitest run tests/architecture",
    "test:watch": "vitest",
    "verify:team-concurrency": "tsx scripts/verify-team-concurrency.ts",
    "verify:team-workspace": "tsx scripts/verify-team-workspace.ts",
    "verify:file-upload": "tsx scripts/verify-file-upload.ts",
    "verify:announcement-attachments": "tsx scripts/verify-announcement-attachments.ts",
    "verify:report-flow": "tsx scripts/verify-report-flow.ts",
    "verify:translation": "tsx scripts/verify-translation.ts",
    "verify:project-program": "tsx scripts/verify-project-program.ts",
    "verify:user-administration": "tsx scripts/verify-user-administration.ts",
    "verify:project-assistant": "tsx scripts/verify-project-assistant.ts",
    "cleanup:uploads": "tsx scripts/cleanup-uploads.ts",
    "db:import-opus": "tsx scripts/import-opus-archive.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.23",
    "dotenv": "17.4.2",
    "google-auth-library": "^11.0.2",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "pdfkit": "0.19.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.18"
  }
}
