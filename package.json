{
  "name": "pnu-project-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
