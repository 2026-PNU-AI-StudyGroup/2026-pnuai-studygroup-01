{
  "name": "pnu-project-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "predb:bootstrap-admin": "prisma generate",
    "db:bootstrap-admin": "prisma db seed",
    "db:seed-demo": "tsx scripts/seed-demo-data.ts",
    "notifications:deadlines": "tsx scripts/generate-deadline-notifications.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:watch": "vitest",
    "verify:team-concurrency": "tsx scripts/verify-team-concurrency.ts",
    "verify:team-application-flow": "tsx scripts/verify-team-application-flow.ts",
    "verify:team-workspace": "tsx scripts/verify-team-workspace.ts",
    "verify:file-upload": "tsx scripts/verify-file-upload.ts",
    "verify:report-flow": "tsx scripts/verify-report-flow.ts",
    "verify:translation": "tsx scripts/verify-translation.ts",
    "verify:project-program": "tsx scripts/verify-project-program.ts",
    "verify:user-administration": "tsx scripts/verify-user-administration.ts",
    "cleanup:uploads": "tsx scripts/cleanup-uploads.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.23",
    "dotenv": "17.4.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "pdfkit": "0.19.1",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.18"
  }
}
