# Application
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# `openssl rand -base64 48`로 생성한 값을 사용하세요. 예시 문자열로는 기동되지 않습니다.
BETTER_AUTH_SECRET=replace_with_a_random_secret_generated_locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_ADMIN_EMAIL=
# 외부 스케줄러가 /api/cron/deadlines를 호출할 때 사용하는 32자 이상의 무작위 값입니다.
CRON_SECRET=

# PostgreSQL
POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pms:pms_local_password@localhost:5432/pms?schema=public

# MinIO
MINIO_ROOT_USER=pms
MINIO_ROOT_PASSWORD=pms_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=pms-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pms
S3_SECRET_KEY=pms_local_password
S3_FORCE_PATH_STYLE=true

# Native Ollama on macOS
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
